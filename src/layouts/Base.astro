---
import { Font } from "astro:assets";
import type { CssVariable, FontPreloadFilter } from "astro:assets";
import "../styles/base.css";

interface Props {
  title: string;
  description?: string;
  /** Google Fonts css2 query, e.g. "family=Inter:wght@400;500" (pages not yet self-hosted) */
  fonts?: string;
  /** self-hosted families from astro.config `fonts`, beyond the chrome's Inter + Instrument Serif */
  selfHosted?: { cssVariable: CssVariable; preload?: FontPreloadFilter }[];
  bodyClass?: string;
  image?: string;
  noindex?: boolean;
}

const {
  title,
  description = "Jayasankar M R — engineer and photographer from Kerala. Career, projects, photography, travel and writing.",
  fonts,
  selfHosted = [],
  bodyClass,
  image = "/photography/images/hero.jpg",
  noindex = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href='data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 64 64"><rect width="64" height="64" fill="%230a0a0a"/><circle cx="32" cy="32" r="11" fill="%23c8b493"/></svg>' />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title="Writing — Jayasankar M R" href="/rss.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- shared header/footer (public/shared/) — same files the photography page loads; its
         fonts are self-hosted here (chrome.css falls back to Google's on /photography/) -->
    <Font cssVariable="--font-inter" />
    <Font cssVariable="--font-instrument" />
    {selfHosted.map((f) => <Font cssVariable={f.cssVariable} preload={f.preload} />)}
    <link rel="stylesheet" href="/shared/chrome.css" />
    <script is:inline src="/shared/chrome.js" defer></script>
    {fonts && <link rel="preconnect" href="https://fonts.googleapis.com" />}
    {fonts && <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />}
    {fonts && <link rel="stylesheet" href={`https://fonts.googleapis.com/css2?${fonts}&display=swap`} />}
    <script is:inline>
      document.documentElement.classList.add("js");
      if (matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("reduce-motion");
      // intro loader already played this visit (scripts/motion/loader.ts) — hide it before first paint
      try { if (sessionStorage.getItem("jmr-intro") === "1") document.documentElement.classList.add("intro-seen"); } catch (e) {}
      // failsafe: if page scripts never take over (network or bundling error), don't
      // leave the intro loader covering the page — drop it and show everything
      setTimeout(function () {
        var h = document.documentElement;
        if (h.classList.contains("is-loaded") || h.classList.contains("loader-running")) return;
        h.classList.add("is-loaded");
        var l = document.querySelector("[data-loader]");
        if (l) l.remove();
      }, 5000);
    </script>
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />
  </body>
</html>

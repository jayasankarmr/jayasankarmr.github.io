---
// Home — the journey is the story. A globe is the spine of the page; career and
// photography each have their own page (/career/, /photography/).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/cursor.css";
import { site } from "../data/site";
import { places, type Place } from "../data/travel";
import { concerts } from "../data/concerts";
import { now, interests } from "../data/now";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const coord = (lat: number, lng: number) => `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? "N" : "S"} ${Math.abs(lng).toFixed(2)}°${lng >= 0 ? "E" : "W"}`;
const when = (d: string) => new Date(d.length === 4 ? `${d}-01-01` : `${d}-01`).toLocaleDateString("en-GB", d.length === 4 ? { year: "numeric" } : { month: "short", year: "numeric" });
const pad = (n: number) => String(n).padStart(2, "0");
const real = places.filter((p) => !p.placeholder).length;
const dated = (p: Place) => p.when ? (p.recurring ? `Since ${when(p.when)} · on repeat` : when(p.when)) : null;
const showDate = (d: string) => new Date(d.length === 7 ? `${d}-01` : d).toLocaleDateString("en-GB", d.length === 7 ? { month: "short", year: "numeric" } : { day: "numeric", month: "short", year: "numeric" });
const cities = new Set(concerts.map((c) => c.city)).size;
---
<Base
  title="Jayasankar M R — engineer & photographer"
  fonts="family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,50;1,9..144,300..600,50&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500"
  bodyClass="at"
>
  <div class="at-loader" data-loader>
    <p class="at-mono">Charting a route from {coord(places[0].lat, places[0].lng)}</p>
    <p class="at-loader__count"><span data-loader-count>000</span></p>
    <span class="at-loader__bar" data-loader-bar></span>
  </div>

  <canvas class="at-globe" data-globe aria-hidden="true"></canvas>
  <div class="at-labels" data-labels aria-hidden="true">
    {places.map((p, i) => (
      <div class:list={["at-label", { "is-tba": p.placeholder }]} data-label={i}>
        <span class="at-label__name">{p.name}</span>
        {p.photo && <img src={p.photo} alt="" loading="lazy" decoding="async" />}
      </div>
    ))}
  </div>

  <SiteNav current="home"><span data-pos>{coord(places[0].lat, places[0].lng)} · {places[0].name}</span></SiteNav>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="at-hero" data-hero aria-labelledby="at-name">
      <div class="at-hero__col">
        <p class="at-mono at-kicker" data-hero-in>An atlas of one — Vol. 01</p>
        <h1 id="at-name" class="at-hero__title">
          <span class="at-hero__line" data-hero-line>Jayasankar</span>
          <span class="at-hero__line at-hero__line--it" data-hero-line><em>from Kerala, outward.</em></span>
        </h1>
        <p class="at-hero__intro" data-hero-in>{site.intro}</p>
        <div class="at-hero__ctas" data-hero-in>
          <a class="at-btn at-btn--solid" href="#journey" data-magnetic="0.25">Begin the journey <span aria-hidden="true">↓</span></a>
          <a class="at-btn" href="/career/" data-magnetic="0.25">Career &amp; code <span aria-hidden="true">→</span></a>
          <a class="at-btn" href="/photography/" data-magnetic="0.25">Photography <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <p class="at-hero__hint at-mono" data-hero-in aria-hidden="true">Drag to turn the world</p>
    </section>

    <!-- ============ JOURNEY ============ -->
    <section class="at-journey" id="journey" aria-label="Journey">
      <div class="at-rail" aria-hidden="true"><span class="at-rail__fill" data-rail-fill></span></div>
      {places.map((p, i) => (
        <article class:list={["at-stop", { "is-tba": p.placeholder }]} data-stop={i} data-lat={p.lat} data-lng={p.lng} data-name={p.name} data-leg={p.leg ? "" : undefined}>
          <div class="at-stop__inner">
          <span class="at-stop__node" aria-hidden="true"></span>
          <div class="at-stop__card">
            <p class="at-mono at-kicker">Stop {pad(i + 1)} / {pad(places.length)} · {p.home ? "Home" : dated(p) ?? p.region}</p>
            <h2 class="at-stop__name">{p.name}</h2>
            <div class="at-stop__more"><div>
              <p class="at-mono at-stop__coord">{p.placeholder ? p.region : coord(p.lat, p.lng)}</p>
              <p class="at-stop__note">{p.note}</p>
              {p.link && <a class="at-stop__link at-mono" href={p.link} target="_blank" rel="noopener">See the trip ↗</a>}
              {p.photo && <img class="at-stop__photo" src={p.photo} alt={`Photograph from ${p.name}`} loading="lazy" decoding="async" />}
            </div></div>
          </div>
          </div>
        </article>
      ))}
    </section>

    <!-- ============ NOTEBOOK ============ -->
    <section class="at-notebook" id="notebook" aria-label="Route, pages, now, writing and interests">
      <header class="at-notebook__head">
        <p class="at-mono at-kicker" data-reveal>The logbook</p>
        <h2 class="at-notebook__title" data-reveal="split">Everything I carry <em>between the stops.</em></h2>
      </header>

      <div class="at-notebook__grid">
        <div class="at-panel at-panel--route" data-reveal>
          <h3 class="at-panel__title">The route <span class="at-mono">{real} places · more to come</span></h3>
          <ol role="list" class="at-timeline" tabindex="0" aria-label="Places, in order" data-lenis-prevent>
            {places.map((p) => (
              <li class:list={[{ "is-home": p.home, "is-tba": p.placeholder }]}>
                <span class="at-mono">{p.home ? "Home" : p.placeholder ? "TBA" : dated(p) ?? "Date to add"}</span>
                <strong>{p.name}</strong>
                <span>{p.region}</span>
              </li>
            ))}
          </ol>
        </div>

        <a class="at-door at-door--career" href="/career/" data-reveal data-cursor="Enter">
          <span class="at-mono">Page 02</span>
          <strong>Career <em>&amp; projects</em></strong>
          <span>Where I’ve worked, what I’ve shipped, and the code behind it — read as a git log.</span>
          <span class="at-door__go" aria-hidden="true">→</span>
        </a>

        <a class="at-door at-door--photo" href="/photography/" data-reveal data-cursor="Enter">
          <img src="/photography/images/hero.jpg" alt="" loading="lazy" decoding="async" />
          <span class="at-mono">Page 03</span>
          <strong>Photo<em>graphy</em></strong>
          <span>Travel, architecture, wildlife and street — developed from the negative.</span>
          <span class="at-door__go" aria-hidden="true">→</span>
        </a>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Now <span class="at-mono">{now.updated}</span></h3>
          <ul role="list" class="at-bullets">{now.items.map((t) => <li>{t}</li>)}</ul>
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Writing</h3>
          {posts.slice(0, 3).map((p) => (
            <a class="at-post" href={`/writing/${p.id}/`} data-cursor="Read">
              <strong>{p.data.title}</strong>
              <span>{p.data.summary}</span>
            </a>
          ))}
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Interests</h3>
          <dl class="at-interests">
            {interests.map((i) => <div><dt>{i.name}</dt><dd>{i.note}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ LIVE ============ -->
    <section class="at-live" id="live" aria-labelledby="at-live-title">
      <header class="at-live__head">
        <p class="at-mono at-kicker" data-reveal>Ticket stubs</p>
        <h2 id="at-live-title" class="at-live__title" data-reveal="split">Some stops were <em>for the music.</em></h2>
        <p class="at-mono at-live__count" data-reveal>{concerts.length} shows · {cities} cities</p>
      </header>
      <ol role="list" class="at-stubs">
        {concerts.map((c, i) => (
          <li class="at-stub" data-reveal>
            <div class="at-stub__main">
              <span class="at-mono">Admit one · No. {pad(i + 1)}</span>
              <strong class="at-stub__artist">{c.artist}</strong>
              <span class="at-stub__where">{c.event ? `${c.event}, ${c.city}` : c.city}</span>
            </div>
            <div class="at-stub__tear">
              <time class="at-mono" datetime={c.when}>{showDate(c.when)}</time>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="at-footer" id="contact">
      <p class="at-mono at-kicker">Next stop</p>
      <a class="at-footer__cta" href={`mailto:${site.email}`} data-reveal="split" data-cursor="Write">Where <em>next?</em></a>
      <SiteFooter current="home" />
    </footer>
  </main>
</Base>

<script>
  import "../scripts/pages/home";
</script>

<style is:global>
  body.at {
    --night: #04050d;
    --night-2: #0a0c1f;
    --ink: #eef0ff;
    --muted: rgba(226, 230, 255, 0.62);
    --faint: rgba(200, 208, 255, 0.15);
    /* warm accent against a cool planet: route, pins, kickers */
    --accent: #ffb454;
    --accent-2: #ff6f91;
    /* globe: land shades cyan (north) → violet (south) inside an electric-blue halo */
    --land-n: #6ff2e0;
    --land-s: #9d7bff;
    --atmo: #4d7cff;
    --font-display: "Fraunces", Georgia, serif;
    --font-body: "Manrope", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, monospace;
    --gutter: clamp(1.25rem, 4vw, 3.5rem);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cursor-ink: var(--accent);
    --cursor-fill: var(--accent);
    --cursor-label: var(--night);
    --focus: var(--accent);
    --chrome-ink: var(--ink);
    --chrome-muted: var(--muted);
    --chrome-line: var(--faint);
    --chrome-bg: rgba(4, 5, 13, 0.72);
    --chrome-accent: var(--accent);
    background:
      radial-gradient(90% 70% at 78% 18%, rgba(77, 124, 255, 0.22) 0%, transparent 60%) fixed,
      radial-gradient(70% 60% at 10% 90%, rgba(157, 123, 255, 0.16) 0%, transparent 60%) fixed,
      var(--night);
    color: var(--ink);
    font: 400 1rem/1.65 var(--font-body);
  }
  .at ::selection { background: var(--accent); color: var(--night); }
  .at em { font-style: italic; }
  .at-mono { font: 500 0.6875rem/1.4 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .at-kicker { color: var(--accent); margin-bottom: 1.25rem; }

  /* ---- loader ---- */
  .at-loader { position: fixed; inset: 0; z-index: 100; background: var(--night); display: grid; place-content: center; justify-items: center; gap: 1rem; clip-path: inset(0); }
  html:not(.js) .at-loader { display: none; }
  .at-loader .at-mono { color: var(--muted); }
  .at-loader__count { font: italic 300 clamp(5rem, 16vw, 12rem)/0.9 var(--font-display); font-variant-numeric: tabular-nums; background: linear-gradient(100deg, var(--land-n), var(--land-s)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .at-loader__bar { position: absolute; left: 50%; bottom: 20%; width: min(18rem, 60vw); height: 1px; translate: -50% 0; background: linear-gradient(90deg, var(--land-n), var(--land-s)); transform: scaleX(0); }

  /* ---- globe + labels ---- */
  .at-globe { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; transition: opacity 0.8s; }
  .at-globe:not(.is-live) { opacity: 0; }
  .at-globe.is-away, .at-labels.is-away { opacity: 0; pointer-events: none; }
  html:not(.has-cursor) .at-globe { pointer-events: none; }
  html.has-cursor .at-globe { cursor: grab; }
  .at-labels { position: fixed; inset: 0; z-index: 1; pointer-events: none; transition: opacity 0.8s; }
  .at-label { position: absolute; top: 0; left: 0; display: grid; gap: 0.5rem; justify-items: start; will-change: transform; transition: opacity 0.4s; }
  .at-label__name { margin-left: 14px; font: 500 0.625rem var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); white-space: nowrap; translate: 0 -50%; }
  .at-label.is-active .at-label__name { color: var(--accent); text-shadow: 0 0 12px rgba(255, 180, 84, 0.6); }
  /* placeholder stops only name themselves while they're the active stop */
  .at-label.is-tba:not(.is-active) .at-label__name { visibility: hidden; }
  .at-label img { margin-left: 18px; width: 9rem; aspect-ratio: 4 / 5; object-fit: cover; border: 4px solid var(--ink); box-shadow: 0 20px 50px rgba(77, 124, 255, 0.35); rotate: -3deg; opacity: 0; transform: translateY(10px) scale(0.9); transition: opacity 0.6s var(--ease), transform 0.8s var(--ease); }
  .at-label.is-active img { opacity: 1; transform: none; }
  @media (max-width: 767px) { .at-label img { width: 5.5rem; } }

  main { position: relative; z-index: 2; pointer-events: none; }
  main a, main button, .at-stop__card, .at-notebook, .at-footer { pointer-events: auto; }

  /* ---- hero ---- */
  .at-hero { min-height: 100svh; display: grid; align-items: center; padding: 7rem var(--gutter) 4rem; position: relative; }
  .at-hero__col { max-width: 40rem; }
  .at-hero__title { font: 300 clamp(3.75rem, 10vw, 9.5rem)/0.9 var(--font-display); letter-spacing: -0.035em; font-variation-settings: "SOFT" 50, "opsz" 144; }
  .at-hero__line { display: block; }
  .at-hero__line--it { font-size: 0.42em; letter-spacing: -0.01em; margin-top: 0.35em; color: var(--accent); line-height: 1.05; }
  .at-hero__intro { margin-top: 2rem; max-width: 30rem; color: var(--muted); font-size: 1.0625rem; }
  .at-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .at-btn { display: inline-flex; gap: 0.6rem; align-items: center; padding: 0.85rem 1.4rem; border: 1px solid var(--faint); border-radius: 999px; text-decoration: none; font-weight: 500; font-size: 0.9375rem; backdrop-filter: blur(6px); transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  .at-btn:hover { border-color: var(--accent); color: var(--accent); }
  .at-btn--solid { background: var(--accent); color: var(--night); border-color: var(--accent); box-shadow: 0 0 32px rgba(255, 180, 84, 0.35); }
  .at-btn--solid:hover { background: transparent; }
  .at-hero__hint { position: absolute; right: var(--gutter); bottom: 2rem; color: var(--muted); }
  @media (max-width: 767px) {
    .at-hero { align-items: end; padding-top: 55svh; }
    .at-hero__hint { display: none; }
  }
  html.js .at-hero [data-hero-in] { opacity: 0; transform: translateY(16px); }

  /* ---- journey ---- */
  .at-journey { position: relative; --rail-x: var(--gutter); --rail-gap: 2.25rem; padding-block: 30svh; }
  /* stops sit close together (5–6 per screen); the height is fixed so the active card grows over its neighbours without moving the page */
  .at-stop { position: relative; height: clamp(8.5rem, 16svh, 11rem); display: flex; align-items: center; padding: 0 var(--gutter) 0 calc(var(--gutter) + var(--rail-gap)); }
  .at-stop.is-current { z-index: 1; }
  .at-stop__inner { position: relative; width: min(26rem, 100%); }
  .at-stop__card {
    width: 100%; transform-origin: left center; padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--faint); border-radius: 6px;
    background: color-mix(in srgb, var(--night-2) 70%, transparent); backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(111, 242, 224, 0.12), 0 30px 60px rgba(0, 0, 0, 0.35);
  }
  .at-stop.is-tba .at-stop__card { border-style: dashed; }

  /* the rail threads every stop; its fill tracks the activation line (55% of the viewport) */
  .at-rail {
    position: absolute; top: 0; bottom: 0; left: var(--rail-x); width: 1px; pointer-events: none;
    background: rgba(200, 208, 255, 0.22);
    mask: linear-gradient(transparent, #000 40svh, #000 calc(100% - 40svh), transparent);
  }
  .at-rail__fill { position: absolute; inset: 0 -0.5px; background: var(--accent); box-shadow: 0 0 8px rgba(255, 180, 84, 0.7); transform-origin: top; transform: scaleY(0); }
  .at-stop__node {
    position: absolute; top: 50%; left: calc(-1 * var(--rail-gap)); width: 9px; height: 9px; translate: -4px -50%; border-radius: 50%;
    background: var(--night); border: 1px solid var(--muted); transition: background-color 0.5s, border-color 0.5s, box-shadow 0.5s, scale 0.5s var(--ease);
  }
  /* a short tick joins the node to its card */
  .at-stop__node::after { content: ""; position: absolute; top: 50%; left: 100%; width: calc(var(--rail-gap) - 5px); height: 1px; background: var(--faint); transition: background-color 0.5s; }
  .at-stop.is-past .at-stop__node { background: var(--accent); border-color: var(--accent); }
  .at-stop.is-current .at-stop__node { background: var(--accent); border-color: var(--accent); scale: 1.5; box-shadow: 0 0 0 5px rgba(255, 180, 84, 0.18), 0 0 16px rgba(255, 180, 84, 0.8); }
  .at-stop.is-current .at-stop__node::after { background: var(--accent); }

  /* the stop you're on steps forward; the rest recede */
  html:not(.no-globe) .at-stop__card {
    transform: scale(0.64); opacity: 0.32; background: transparent; backdrop-filter: blur(0); box-shadow: none; border-color: transparent;
    transition: transform 0.8s var(--ease), opacity 0.6s var(--ease), background-color 0.6s, backdrop-filter 0.6s, border-color 0.6s, box-shadow 0.8s;
  }
  html:not(.no-globe) .at-stop:hover .at-stop__card { opacity: 0.6; }
  html:not(.no-globe) .at-stop.is-current .at-stop__card {
    transform: scale(1.06); opacity: 1; border-color: rgba(255, 180, 84, 0.45);
    background: color-mix(in srgb, var(--night-2) 88%, transparent); backdrop-filter: blur(14px);
    box-shadow: inset 0 1px 0 rgba(111, 242, 224, 0.12), 0 40px 80px rgba(0, 0, 0, 0.45), 0 0 40px rgba(255, 180, 84, 0.12);
  }
  /* receded stops show only kicker + name; the details open on the current stop */
  .at-stop__more { display: grid; grid-template-rows: 1fr; }
  .at-stop__more > div { min-height: 0; overflow: hidden; }
  html:not(.no-globe) .at-stop__more { grid-template-rows: 0fr; opacity: 0; transition: grid-template-rows 0.8s var(--ease), opacity 0.5s; }
  html:not(.no-globe) .at-stop.is-current .at-stop__more { grid-template-rows: 1fr; opacity: 1; transition-delay: 0.1s; }
  html:not(.no-globe) .at-stop:not(.is-current) .at-kicker { margin-bottom: 0.5rem; }
  .at-stop.is-tba .at-stop__name { opacity: 0.55; }
  .at-stop__name { font: 300 clamp(2.75rem, 5.5vw, 4.5rem)/0.95 var(--font-display); letter-spacing: -0.03em; }
  .at-stop__coord { margin-top: 0.75rem; color: var(--muted); }
  .at-stop__note { margin-top: 1.25rem; font: italic 400 1.25rem/1.4 var(--font-display); }
  .at-stop__link { display: inline-block; margin-top: 1.25rem; color: var(--land-n); text-decoration: none; }
  .at-stop__link:hover { color: var(--accent); }
  .at-stop__photo { display: none; margin-top: 1.25rem; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 2px; }
  /* no globe (reduced motion / no WebGL) → photos live in the cards instead of on the map */
  html.no-globe .at-stop__photo { display: block; }
  html.no-globe .at-stop { height: auto; padding-block: 2rem; }
  html.no-globe .at-journey { padding-block: 0; }
  html.no-globe .at-rail__fill { transform: none; }
  @media (max-width: 767px) {
    .at-journey { --rail-gap: 1.5rem; }
    .at-stop { height: clamp(6.5rem, 13svh, 8rem); }
    .at-stop__inner { width: 100%; }
  }

  /* ---- notebook ---- */
  .at-notebook { position: relative; padding: clamp(6rem, 16vh, 10rem) var(--gutter); background: linear-gradient(transparent, var(--night) 12rem); }
  .at-notebook__title { font: 300 clamp(2.5rem, 6vw, 5.5rem)/1 var(--font-display); letter-spacing: -0.03em; max-width: 16ch; }
  .at-notebook__title em { color: var(--accent); }
  .at-notebook__grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1rem; margin-top: clamp(3rem, 8vh, 5rem); }
  .at-panel { grid-column: span 4; padding: 1.75rem; border: 1px solid var(--faint); border-radius: 6px; background: rgba(10, 12, 31, 0.6); }
  /* size-contained so the long route doesn't stretch the two doors beside it; its list scrolls instead */
  .at-panel--route { grid-column: span 5; grid-row: span 2; contain: size; display: flex; flex-direction: column; }
  .at-panel--route .at-timeline {
    flex: 1; min-height: 0; padding-bottom: 2.5rem; overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; scrollbar-color: var(--faint) transparent;
    mask-image: linear-gradient(#000 calc(100% - 3rem), transparent);
  }
  .at-panel__title { display: flex; justify-content: space-between; align-items: baseline; gap: 1rem; font: 400 1.75rem var(--font-display); margin-bottom: 1.25rem; }
  .at-panel__title .at-mono { color: var(--muted); text-align: right; }

  /* doorways to the other two pages */
  .at-door {
    grid-column: span 7; position: relative; overflow: hidden; isolation: isolate; display: grid; align-content: end; gap: 0.5rem;
    min-height: 13rem; padding: 1.5rem 1.75rem; border: 1px solid var(--faint); border-radius: 6px; text-decoration: none;
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  .at-door strong { font: 300 clamp(2rem, 3.4vw, 3rem)/0.95 var(--font-display); letter-spacing: -0.03em; }
  .at-door strong em { color: var(--accent); }
  .at-door > span:not(.at-mono):not(.at-door__go) { color: var(--muted); max-width: 34rem; }

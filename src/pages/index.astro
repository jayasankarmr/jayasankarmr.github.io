---
// Home — the journey is the story. A globe is the spine of the page; career and
// photography each have their own page (/career/, /photography/).
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import SiteNav from "../components/SiteNav.astro";
import SiteFooter from "../components/SiteFooter.astro";
import "../styles/cursor.css";
import { site } from "../data/site";
import { places, type Place } from "../data/travel";
import { concerts } from "../data/concerts";
import { now, interests } from "../data/now";
import { buildLegs, formatKm } from "../scripts/atlas/journey";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const coord = (lat: number, lng: number) => `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? "N" : "S"} ${Math.abs(lng).toFixed(2)}°${lng >= 0 ? "E" : "W"}`;
const when = (d: string) => new Date(d.length === 4 ? `${d}-01-01` : `${d}-01`).toLocaleDateString("en-GB", d.length === 4 ? { year: "numeric" } : { month: "short", year: "numeric" });
const pad = (n: number) => String(n).padStart(2, "0");
const real = places.filter((p) => !p.placeholder).length;
const dated = (p: Place) => p.when ? (p.recurring ? `Since ${when(p.when)} · on repeat` : when(p.when)) : null;
const showDate = (d: string) => new Date(d.length === 7 ? `${d}-01` : d).toLocaleDateString("en-GB", d.length === 7 ? { month: "short", year: "numeric" } : { day: "numeric", month: "short", year: "numeric" });
const cities = new Set(concerts.map((c) => c.city)).size;

// journey: legs, trips and distances come from the data (src/scripts/atlas/journey.ts)
const legs = buildLegs(places);
const n = places.length;
const railY = (i: number) => (i / (n - 1)) * 1000;
// the rail is a flight path: stops sit on x = 30 of a 40 × 1000 box, each leg bowing left by its arc height
const railPath = legs.reduce((d, l, k) => {
  const bow = Math.min(1, l.height / 0.18) * 26;
  return d + `Q${(30 - bow * 2).toFixed(2)} ${((railY(k) + railY(k + 1)) / 2).toFixed(1)} 30 ${railY(k + 1).toFixed(1)}`;
}, "M30 0");
const MODE = { flight: "By air", train: "By train", road: "By road", bus: "By bus", ferry: "By ferry" } as const;
const stopData = places.map((p) => ({ name: p.name, region: p.region, lat: p.lat, lng: p.lng, when: p.when && when(p.when), recurring: !!p.recurring, home: !!p.home, leg: !!p.leg }));
---
<Base
  title="Jayasankar M R — engineer & photographer"
  selfHosted={[
    { cssVariable: "--font-fraunces", preload: [{ style: "normal" }] },
    { cssVariable: "--font-manrope" },
    { cssVariable: "--font-plex-mono" },
  ]}
  bodyClass="at"
>
  <div class="at-loader" data-loader>
    <p class="at-mono">Charting a route from {coord(places[0].lat, places[0].lng)}</p>
    <p class="at-loader__count"><span data-loader-count>000</span></p>
    <span class="at-loader__bar" data-loader-bar></span>
  </div>

  <canvas class="at-globe" data-globe aria-hidden="true"></canvas>
  <div class="lbls" data-labels aria-hidden="true"></div>

  <SiteNav current="home"><span data-pos>{coord(places[0].lat, places[0].lng)} · {places[0].name}</span></SiteNav>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="at-hero" data-hero aria-labelledby="at-name">
      <div class="at-hero__col">
        <p class="at-mono at-kicker" data-hero-in>An atlas of one — Vol. 01</p>
        <h1 id="at-name" class="at-hero__title">
          <span class="at-hero__line" data-hero-line>Jayasankar</span>
          <span class="at-hero__line at-hero__line--it" data-hero-line><em>from Kerala, outward.</em></span>
        </h1>
        <p class="at-hero__intro" data-hero-in>{site.intro}</p>
        <div class="at-hero__ctas" data-hero-in>
          <a class="at-btn at-btn--solid" href="#journey" data-magnetic="0.25">Begin the journey <span aria-hidden="true">↓</span></a>
          <a class="at-btn" href="/career/" data-magnetic="0.25">Career &amp; code <span aria-hidden="true">→</span></a>
          <a class="at-btn" href="/photography/" data-magnetic="0.25">Photography <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <div class="at-hero__hint" data-hero-in aria-hidden="true">
        <svg class="at-gesture" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
          <circle cx="24" cy="22" r="13" opacity="0.45" />
          <ellipse class="at-gesture__meridian" cx="24" cy="22" rx="6" ry="13" opacity="0.8" />
          <path d="M8 35.5c10 5 22 5 32 0" opacity="0.55" />
          <path d="M36.2 33.4l3.8 2.1-2.4 3.4" opacity="0.55" />
          <circle class="at-gesture__dot" cx="24" cy="38" r="2.1" fill="currentColor" stroke="none" />
        </svg>
        <span class="at-mono">Drag</span>
      </div>
      <div class="at-globe-ctl" data-globe-ctl tabindex="0" role="group" aria-roledescription="interactive globe" aria-label="Globe of the journey. Arrow keys turn it; Home recentres."></div>
    </section>

    <!-- ============ JOURNEY ============ -->
    <section class="jr" id="journey" aria-labelledby="jr-title" data-journey data-stops={JSON.stringify(stopData)}>
      <h2 id="jr-title" class="sr-only">Journey</h2>
      <!-- the journey for screen readers: every stop, in order (the visual deck mirrors it) -->
      <ol class="jr-sr sr-only" role="list">
        {places.map((p, i) => (
          <li>
            <h3>Stop {i + 1} of {n}: {p.name}</h3>
            <p>{p.region}. {p.home ? "Home." : dated(p) ? `${dated(p)}.` : ""} {coord(p.lat, p.lng)}.{i > 0 && ` ${formatKm(legs[i - 1].km)} from ${places[i - 1].name}${legs[i - 1].overland ? ", overland" : ""}.`}</p>
            <p>{p.note}</p>
            {p.link && <a href={p.link} target="_blank" rel="noopener">See the trip to {p.name}</a>}
          </li>
        ))}
      </ol>
      <div class="jr__track" data-track>
        {places.map((_, i) => <span class="jr__snap" data-snap={i} aria-hidden="true"></span>)}
        <div class="jr__stage" data-stage>
          <nav class="jr-rail" data-rail aria-label="Journey stops">
            <svg class="jr-rail__path" viewBox="0 0 40 1000" preserveAspectRatio="none" aria-hidden="true">
              <path class="jr-rail__route" d={railPath} vector-effect="non-scaling-stroke" />
              <path class="jr-rail__flown" data-rail-fill d="M30 0" vector-effect="non-scaling-stroke" />
            </svg>
            <ol class="jr-rail__stops" role="list">
              {places.map((p, i) => (
                <li style={`--at: ${((i / (n - 1)) * 100).toFixed(3)}%`}>
                  <button type="button" class="jr-rail__stop" data-rail-stop={i} tabindex={i === 0 ? 0 : -1}>
                    <span class="jr-rail__node" aria-hidden="true"></span>
                    <span class="sr-only">Stop {i + 1}: </span>
                    <span class="jr-rail__name">{p.name}</span>
                    <span class="jr-rail__date">{p.home ? "Home" : p.when ? when(p.when) : ""}</span>
                  </button>
                </li>
              ))}
            </ol>
            <span class="jr-rail__plane" data-rail-plane aria-hidden="true">
              <svg viewBox="0 0 16 16"><path d="M8 1.5 9.6 7l4.9 2.4v1.4L9.6 9.4 9.2 12.6l1.6 1.2V15L8 14.2 5.2 15v-1.2l1.6-1.2-.4-3.2-4.9 1.4V9.4L6.4 7Z" fill="currentColor" /></svg>
              <span class="jr-rail__alt at-mono" data-rail-alt>Alt —</span>
            </span>
          </nav>
          <div class="jr-deck" data-deck aria-hidden="true">
            {places.map((p, i) => {
              const leg = i > 0 ? legs[i - 1] : null;
              return (
                <article class:list={["pass", { "is-home": p.home, "is-tba": p.placeholder, "is-current": i === 0 }]} data-card={i}>
                  <div class="pass__face">
                    <header class="pass__head">
                      <p class="pass__no at-mono">Stop <b>{pad(i + 1)}</b> / {pad(n)}</p>
                      <p class="pass__when at-mono">{p.home ? "Home" : dated(p) ?? p.region}</p>
                    </header>
                    <h3 class="pass__name">{p.name}</h3>
                    <p class="pass__coord at-mono">{coord(p.lat, p.lng)} · {p.region}</p>
                    <p class="pass__note">{p.note}</p>
                    {p.photo && (
                      <figure class="pass__photo"><img src={p.photo} alt={p.photoAlt ?? `Photograph from ${p.name}`} loading="lazy" decoding="async" /></figure>
                    )}
                    {p.link && <a class="pass__link at-mono" href={p.link} target="_blank" rel="noopener" tabindex="-1">See the trip ↗</a>}
                    <footer class="pass__stub at-mono">
                      {leg ? (
                        <>
                          <span class="pass__leg"><span>From {places[i - 1].name}</span><span aria-hidden="true">→</span></span>
                          <span>{formatKm(leg.km)}</span>
                          {p.mode ? <span>{MODE[p.mode]}</span> : leg.overland && <span>Overland</span>}
                          <span>Trip {pad(leg.trip)}</span>
                        </>
                      ) : (
                        <span>Home · {p.region}</span>
                      )}
                    </footer>
                  </div>
                </article>
              );
            })}
          </div>
          <p class="sr-only" aria-live="polite" data-live></p>
        </div>
      </div>
    </section>

    <!-- ============ NOTEBOOK ============ -->
    <section class="at-notebook" id="notebook" aria-label="Route, pages, now, writing and interests">
      <header class="at-notebook__head">
        <p class="at-mono at-kicker" data-reveal>The logbook</p>
        <h2 class="at-notebook__title" data-reveal="split">Everything I carry <em>between the stops.</em></h2>
      </header>

      <div class="at-notebook__grid">
        <div class="at-panel at-panel--route" data-reveal>
          <h3 class="at-panel__title">The route <span class="at-mono">{real} places · more to come</span></h3>
          <ol role="list" class="at-timeline" tabindex="0" aria-label="Places, in order" data-lenis-prevent>
            {places.map((p) => (
              <li class:list={[{ "is-home": p.home, "is-tba": p.placeholder }]}>
                <span class="at-mono">{p.home ? "Home" : p.placeholder ? "TBA" : dated(p) ?? "Date to add"}</span>
                <strong>{p.name}</strong>
                <span>{p.region}</span>
              </li>
            ))}
          </ol>
        </div>

        <a class="at-door at-door--career" href="/career/" data-reveal data-cursor="Enter">
          <span class="at-mono">Page 02</span>
          <strong>Career <em>&amp; projects</em></strong>
          <span>Where I’ve worked, what I’ve shipped, and the code behind it — read as a git log.</span>
          <span class="at-door__go" aria-hidden="true">→</span>
        </a>

        <a class="at-door at-door--photo" href="/photography/" data-reveal data-cursor="Enter">
          <img src="/photography/images/hero.jpg" alt="" loading="lazy" decoding="async" />
          <span class="at-mono">Page 03</span>
          <strong>Photo<em>graphy</em></strong>
          <span>Travel, architecture, wildlife and street — developed from the negative.</span>
          <span class="at-door__go" aria-hidden="true">→</span>
        </a>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Now <span class="at-mono">{now.updated}</span></h3>
          <ul role="list" class="at-bullets">{now.items.map((t) => <li>{t}</li>)}</ul>
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Writing</h3>
          {posts.slice(0, 3).map((p) => (
            <a class="at-post" href={`/writing/${p.id}/`} data-cursor="Read">
              <strong>{p.data.title}</strong>
              <span>{p.data.summary}</span>
            </a>
          ))}
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Interests</h3>
          <dl class="at-interests">
            {interests.map((i) => <div><dt>{i.name}</dt><dd>{i.note}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ LIVE ============ -->
    <section class="at-live" id="live" aria-labelledby="at-live-title">
      <header class="at-live__head">
        <p class="at-mono at-kicker" data-reveal>Ticket stubs</p>
        <h2 id="at-live-title" class="at-live__title" data-reveal="split">Some stops were <em>for the music.</em></h2>
        <p class="at-mono at-live__count" data-reveal>{concerts.length} shows · {cities} cities</p>
      </header>
      <ol role="list" class="at-stubs">
        {concerts.map((c, i) => (
          <li class="at-stub" data-reveal>
            <div class="at-stub__main">
              <span class="at-mono">Admit one · No. {pad(i + 1)}</span>
              <strong class="at-stub__artist">{c.artist}</strong>
              <span class="at-stub__where">{c.event ? `${c.event}, ${c.city}` : c.city}</span>
            </div>
            <div class="at-stub__tear">
              <time class="at-mono" datetime={c.when}>{showDate(c.when)}</time>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="at-footer" id="contact">
      <p class="at-mono at-kicker">Next stop</p>
      <a class="at-footer__cta" href={`mailto:${site.email}`} data-reveal="split" data-cursor="Write">Where <em>next?</em></a>
      <SiteFooter current="home" />
    </footer>
  </main>
</Base>

<script>
  import "../scripts/pages/home";
</script>

<style is:global>
  body.at {
    --night: #04050d;
    --night-2: #0a0c1f;
    --ink: #eef0ff;
    --muted: rgba(226, 230, 255, 0.62);
    --faint: rgba(200, 208, 255, 0.15);
    /* warm accent against a cool planet: route, pins, kickers */
    --accent: #ffb454;
    --accent-2: #ff6f91;
    /* globe: land shades cyan (north) → violet (south) inside an electric-blue halo */
    --land-n: #6ff2e0;
    --land-s: #9d7bff;
    --atmo: #4d7cff;
    --font-display: var(--font-fraunces);
    --font-body: var(--font-manrope);
    --font-mono: var(--font-plex-mono);
    --gutter: clamp(1.25rem, 4vw, 3.5rem);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cursor-ink: var(--accent);
    --cursor-fill: var(--accent);
    --cursor-label: var(--night);
    --focus: var(--accent);
    --chrome-ink: var(--ink);
    --chrome-muted: var(--muted);
    --chrome-line: var(--faint);
    --chrome-bg: rgba(4, 5, 13, 0.72);
    --chrome-accent: var(--accent);
    background:
      radial-gradient(90% 70% at 78% 18%, rgba(77, 124, 255, 0.22) 0%, transparent 60%) fixed,
      radial-gradient(70% 60% at 10% 90%, rgba(157, 123, 255, 0.16) 0%, transparent 60%) fixed,
      var(--night);
    color: var(--ink);
    font: 400 1rem/1.65 var(--font-body);
  }
  .at ::selection { background: var(--accent); color: var(--night); }
  .at em { font-style: italic; }
  .at-mono { font: 500 0.6875rem/1.4 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .at-kicker { color: var(--accent); margin-bottom: 1.25rem; }

  /* ---- loader ---- */
  .at-loader { position: fixed; inset: 0; z-index: 100; background: var(--night); display: grid; place-content: center; justify-items: center; gap: 1rem; clip-path: inset(0); }
  html:not(.js) .at-loader { display: none; }
  .at-loader .at-mono { color: var(--muted); }
  .at-loader__count { font: italic 300 clamp(5rem, 16vw, 12rem)/0.9 var(--font-display); font-variant-numeric: tabular-nums; background: linear-gradient(100deg, var(--land-n), var(--land-s)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .at-loader__bar { position: absolute; left: 50%; bottom: 20%; width: min(18rem, 60vw); height: 1px; translate: -50% 0; background: linear-gradient(90deg, var(--land-n), var(--land-s)); transform: scaleX(0); }

  /* ---- globe + labels ---- */
  .at-globe { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; transition: opacity 0.8s; }
  .at-globe:not(.is-live) { opacity: 0; }
  .at-globe.is-away, .lbls.is-away { opacity: 0; pointer-events: none; }
  html:not(.has-cursor) .at-globe { pointer-events: none; }
  html.has-cursor .at-globe { cursor: grab; }
  /* stop labels, laid out by src/scripts/atlas/labels.ts */
  .lbls { position: fixed; inset: 0; z-index: 1; pointer-events: none; transition: opacity 0.8s; }
  .lbl {
    position: absolute; top: 0; left: 0; opacity: 0; will-change: transform, opacity; white-space: nowrap;
    padding: 2px 4px; font: 500 0.6875rem/1.2 var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase;
    color: rgba(226, 230, 255, 0.84); text-shadow: 0 0 2px var(--night), 0 0 8px rgba(4, 5, 13, 0.95);
  }
  .lbl.is-reached { color: rgba(255, 226, 184, 0.9); }
  .lbl.is-active { font-size: 0.875rem; letter-spacing: 0.12em; color: var(--accent); text-shadow: 0 0 2px var(--night), 0 0 16px rgba(255, 180, 84, 0.55); }
  .lbl--cluster {
    display: flex; gap: 0.55em; align-items: center; padding: 4px 9px 4px 10px; border: 1px solid rgba(200, 208, 255, 0.26); border-radius: 999px;
    background: rgba(4, 5, 13, 0.78); color: rgba(226, 230, 255, 0.9); text-shadow: none;
  }
  .lbl__count { color: var(--accent); }
  .lbl-lines { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .lbl-lines path { fill: none; stroke: rgba(226, 230, 255, 0.5); stroke-width: 1; }

  main { position: relative; z-index: 2; pointer-events: none; }
  main a, main button, .pass, .at-notebook, .at-footer { pointer-events: auto; }

  /* ---- hero ---- */
  .at-hero { min-height: 100svh; display: grid; align-items: center; padding: 7rem var(--gutter) 4rem; position: relative; }
  .at-hero__col { max-width: 40rem; }
  .at-hero__title { font: 300 clamp(3.75rem, 10vw, 9.5rem)/0.9 var(--font-display); letter-spacing: -0.035em; font-variation-settings: "SOFT" 50, "opsz" 144; }
  .at-hero__line { display: block; }
  .at-hero__line--it { font-size: 0.42em; letter-spacing: -0.01em; margin-top: 0.35em; color: var(--accent); line-height: 1.05; }
  .at-hero__intro { margin-top: 2rem; max-width: 30rem; color: var(--muted); font-size: 1.0625rem; }
  .at-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .at-btn { display: inline-flex; gap: 0.6rem; align-items: center; padding: 0.85rem 1.4rem; border: 1px solid var(--faint); border-radius: 999px; text-decoration: none; font-weight: 500; font-size: 0.9375rem; backdrop-filter: blur(6px); transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  .at-btn:hover { border-color: var(--accent); color: var(--accent); }
  .at-btn--solid { background: var(--accent); color: var(--night); border-color: var(--accent); box-shadow: 0 0 32px rgba(255, 180, 84, 0.35); }
  .at-btn--solid:hover { background: transparent; }
  /* drag hint: a globe whose meridian turns while a fingertip sweeps under it */
  .at-hero__hint { position: absolute; right: var(--gutter); bottom: 1.75rem; display: flex; align-items: center; gap: 0.6rem; color: var(--muted); }
  .at-gesture { width: 2.75rem; height: 2.75rem; color: var(--ink); overflow: visible; }
  .at-gesture__meridian { animation: at-meridian 3.2s var(--ease) infinite; }
  .at-gesture__dot { color: var(--accent); animation: at-sweep 3.2s var(--ease) infinite; }
  @keyframes at-meridian { 0%, 100% { rx: 2px; } 50% { rx: 11px; } }
  @keyframes at-sweep { 0%, 100% { transform: translateX(-9px); } 50% { transform: translateX(9px); } }
  @media (hover: none), (prefers-reduced-motion: reduce) { .at-gesture__meridian, .at-gesture__dot { animation: none; } }
  @media (hover: none) { .at-hero__hint { display: none; } }
  /* keyboard handle for the globe: invisible until focused, then a ring that hugs the planet */
  .at-globe-ctl {
    position: fixed; z-index: 1; left: var(--x, 70%); top: var(--y, 50%); width: calc(var(--r, 20rem) * 2); height: calc(var(--r, 20rem) * 2);
    translate: -50% -50%; border-radius: 50%; pointer-events: none; outline: none;
  }
  .at-globe-ctl:focus-visible { box-shadow: 0 0 0 2px var(--accent), 0 0 0 10px rgba(255, 180, 84, 0.16), 0 0 60px rgba(255, 180, 84, 0.25); }
  html.is-dragging-globe, html.is-dragging-globe .at-globe { cursor: grabbing; }
  @media (max-width: 767px) {
    .at-hero { align-items: end; padding-top: 55svh; }
  }
  html.js .at-hero [data-hero-in] { opacity: 0; transform: translateY(16px); }

  /* ---- journey ----
     Default (no JS, reduced motion, no WebGL): a readable list of passes over the globe.
     .is-deck (rich motion): a tall scroll track under a sticky 100svh stage — rail, card slot,
     and the globe behind — driven by src/scripts/atlas/ui/journey.ts. */
  .jr { position: relative; }
  .jr__track { position: relative; padding: 4rem var(--gutter); }
  .jr__snap { display: none; }
  .jr-rail { display: none; }
  .jr-deck { display: grid; gap: 1.25rem; max-width: 28rem; }
  .jr-sr a:focus { position: fixed; top: 5rem; left: var(--gutter); z-index: 50; width: auto; height: auto; clip: auto; padding: 0.6rem 1rem; background: var(--night-2); color: var(--accent); }

  .pass { position: relative; pointer-events: auto; }
  .pass__face {
    position: relative; padding: clamp(1.4rem, 2.4vw, 2rem); border: 1px solid rgba(255, 180, 84, 0.34); border-radius: 12px;
    background: linear-gradient(160deg, rgba(20, 24, 52, 0.94), rgba(8, 10, 26, 0.94));
    box-shadow: inset 0 1px 0 rgba(111, 242, 224, 0.1), 0 30px 70px rgba(0, 0, 0, 0.45), 0 0 44px rgba(255, 180, 84, 0.08);
  }
  .pass.is-tba .pass__face { border-style: dashed; }

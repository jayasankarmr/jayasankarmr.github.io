---
// Concept C — "Atlas": the journey is the story. A globe is the spine of the page.
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import "../../styles/cursor.css";
import { site, socials } from "../../data/site";
import { career } from "../../data/career";
import { getProjects } from "../../data/projects";
import { places } from "../../data/travel";
import { now, interests } from "../../data/now";

const projects = (await getProjects()).slice(0, 6);
const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const coord = (lat: number, lng: number) => `${Math.abs(lat).toFixed(2)}°${lat >= 0 ? "N" : "S"} ${Math.abs(lng).toFixed(2)}°${lng >= 0 ? "E" : "W"}`;
// career entries whose place mentions a stop get shown at that stop
const careerAt = (name: string) => career.filter((c) => c.place?.toLowerCase().includes(name.toLowerCase()));
const yr = (d?: string) => (d ? d.slice(0, 4) : "now");
const pad = (n: number) => String(n).padStart(2, "0");
---
<Base
  title="Jayasankar M R — Atlas (concept C)"
  fonts="family=Fraunces:ital,opsz,wght,SOFT@0,9..144,300..600,50;1,9..144,300..600,50&family=Manrope:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500"
  bodyClass="at"
  noindex
>
  <div class="at-loader" data-loader>
    <p class="at-mono">Charting a route from {coord(places[0].lat, places[0].lng)}</p>
    <p class="at-loader__count"><span data-loader-count>000</span></p>
    <span class="at-loader__bar" data-loader-bar></span>
  </div>

  <canvas class="at-globe" data-globe aria-hidden="true"></canvas>
  <div class="at-labels" data-labels aria-hidden="true">
    {places.map((p, i) => (
      <div class="at-label" data-label={i}>
        <span class="at-label__name">{p.name}</span>
        {p.photo && <img src={p.photo} alt="" loading="lazy" decoding="async" />}
      </div>
    ))}
  </div>

  <header class="at-header">
    <a class="at-header__brand" href="#main">Jayasankar <em>M R</em></a>
    <nav class="at-header__nav" aria-label="Primary">
      <a href="#journey">Journey</a>
      <a href="#notebook">Work</a>
      <a href="/photography/">Photography</a>
      <a href="#contact">Contact</a>
    </nav>
    <p class="at-header__pos at-mono" data-pos>{coord(places[0].lat, places[0].lng)} · {places[0].name}</p>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="at-hero" data-hero aria-labelledby="at-name">
      <div class="at-hero__col">
        <p class="at-mono at-kicker" data-hero-in>An atlas of one — Vol. 01</p>
        <h1 id="at-name" class="at-hero__title">
          <span class="at-hero__line" data-hero-line>Jayasankar</span>
          <span class="at-hero__line at-hero__line--it" data-hero-line><em>from Kerala, outward.</em></span>
        </h1>
        <p class="at-hero__intro" data-hero-in>{site.intro}</p>
        <div class="at-hero__ctas" data-hero-in>
          <a class="at-btn at-btn--solid" href="#journey" data-magnetic="0.25">Begin the journey <span aria-hidden="true">↓</span></a>
          <a class="at-btn" href="/photography/" data-magnetic="0.25">Photography <span aria-hidden="true">→</span></a>
        </div>
      </div>
      <p class="at-hero__hint at-mono" data-hero-in aria-hidden="true">Drag to turn the world</p>
    </section>

    <!-- ============ JOURNEY ============ -->
    <section class="at-journey" id="journey" aria-label="Journey">
      {places.map((p, i) => (
        <article class="at-stop" data-stop={i} data-lat={p.lat} data-lng={p.lng} data-name={p.name}>
          <div class="at-stop__card">
            <p class="at-mono at-kicker">Stop {pad(i + 1)} / {pad(places.length)} · {p.region}</p>
            <h2 class="at-stop__name">{p.name}</h2>
            <p class="at-mono at-stop__coord">{coord(p.lat, p.lng)}</p>
            <p class="at-stop__note">{p.note}</p>
            {careerAt(p.name).length > 0 && (
              <ul role="list" class="at-stop__career">
                {careerAt(p.name).map((c) => (
                  <li><span class="at-mono">{yr(c.start)}–{yr(c.end)}</span> {c.title}, {c.org}</li>
                ))}
              </ul>
            )}
            {p.photo && <img class="at-stop__photo" src={p.photo} alt={`Photograph from ${p.name}`} loading="lazy" decoding="async" />}
          </div>
        </article>
      ))}
    </section>

    <!-- ============ NOTEBOOK ============ -->
    <section class="at-notebook" id="notebook" aria-label="Career, projects, writing and interests">
      <header class="at-notebook__head">
        <p class="at-mono at-kicker" data-reveal>The notebook</p>
        <h2 class="at-notebook__title" data-reveal="split">Everything I carry <em>between the stops.</em></h2>
      </header>

      <div class="at-notebook__grid">
        <div class="at-panel at-panel--career" data-reveal>
          <h3 class="at-panel__title">Career</h3>
          <ol role="list" class="at-timeline">
            {career.map((c) => (
              <li class={`is-${c.kind}`}>
                <span class="at-mono">{yr(c.start)} — {yr(c.end)}</span>
                <strong>{c.title}</strong>
                <span>{c.org}{c.place ? ` · ${c.place}` : ""}</span>
              </li>
            ))}
          </ol>
        </div>

        <div class="at-panel at-panel--projects" data-reveal>
          <h3 class="at-panel__title">Projects</h3>
          <ul role="list" class="at-projects">
            {projects.map((p) => (
              <li>
                <a href={p.url} target="_blank" rel="noopener" data-cursor="Open">
                  <span class="at-mono">{p.language ?? p.tags[0]}</span>
                  <strong>{p.name}</strong>
                  <span>{p.description}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Now <span class="at-mono">{now.updated}</span></h3>
          <ul role="list" class="at-bullets">{now.items.map((t) => <li>{t}</li>)}</ul>
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Writing</h3>
          {posts.slice(0, 3).map((p) => (
            <a class="at-post" href={`/writing/${p.id}/`} data-cursor="Read">
              <strong>{p.data.title}</strong>
              <span>{p.data.summary}</span>
            </a>
          ))}
        </div>

        <div class="at-panel" data-reveal>
          <h3 class="at-panel__title">Interests</h3>
          <dl class="at-interests">
            {interests.map((i) => <div><dt>{i.name}</dt><dd>{i.note}</dd></div>)}
          </dl>
        </div>
      </div>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="at-footer" id="contact">
      <p class="at-mono at-kicker">Next stop</p>
      <a class="at-footer__cta" href={`mailto:${site.email}`} data-reveal="split" data-cursor="Write">Where <em>next?</em></a>
      <div class="at-footer__row">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        <ul role="list">{socials.map((s) => <li><a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a></li>)}</ul>
        <p class="at-mono">© 2026 · {coord(places[0].lat, places[0].lng)}</p>
      </div>
    </footer>
  </main>
</Base>

<script>
  import "../../scripts/concepts/atlas";
</script>

<style is:global>
  body.at {
    --night: #060a12;
    --night-2: #0b1220;
    --ink: #ece5d6;
    --muted: rgba(236, 229, 214, 0.6);
    --faint: rgba(236, 229, 214, 0.14);
    --gold: #f0c270;
    --font-display: "Fraunces", Georgia, serif;
    --font-body: "Manrope", system-ui, sans-serif;
    --font-mono: "IBM Plex Mono", ui-monospace, monospace;
    --gutter: clamp(1.25rem, 4vw, 3.5rem);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cursor-ink: var(--gold);
    --cursor-fill: var(--gold);
    --cursor-label: var(--night);
    --focus: var(--gold);
    background: radial-gradient(120% 80% at 70% 20%, #0d1728 0%, var(--night) 60%) fixed, var(--night);
    color: var(--ink);
    font: 400 1rem/1.65 var(--font-body);
  }
  .at ::selection { background: var(--gold); color: var(--night); }
  .at em { font-style: italic; }
  .at-mono { font: 500 0.6875rem/1.4 var(--font-mono); letter-spacing: 0.12em; text-transform: uppercase; }
  .at-kicker { color: var(--gold); margin-bottom: 1.25rem; }

  /* ---- loader ---- */
  .at-loader { position: fixed; inset: 0; z-index: 100; background: var(--night); display: grid; place-content: center; justify-items: center; gap: 1rem; clip-path: inset(0); }
  html:not(.js) .at-loader { display: none; }
  .at-loader .at-mono { color: var(--muted); }
  .at-loader__count { font: italic 300 clamp(5rem, 16vw, 12rem)/0.9 var(--font-display); color: var(--gold); font-variant-numeric: tabular-nums; }
  .at-loader__bar { position: absolute; left: 50%; bottom: 20%; width: min(18rem, 60vw); height: 1px; translate: -50% 0; background: var(--gold); transform: scaleX(0); }

  /* ---- globe + labels ---- */
  .at-globe { position: fixed; inset: 0; width: 100%; height: 100%; z-index: 0; transition: opacity 0.8s; }
  .at-globe.is-away, .at-labels.is-away { opacity: 0; pointer-events: none; }
  html:not(.has-cursor) .at-globe { pointer-events: none; }
  html.has-cursor .at-globe { cursor: grab; }
  .at-labels { position: fixed; inset: 0; z-index: 1; pointer-events: none; transition: opacity 0.8s; }
  .at-label { position: absolute; top: 0; left: 0; display: grid; gap: 0.5rem; justify-items: start; will-change: transform; transition: opacity 0.4s; }
  .at-label__name { margin-left: 14px; font: 500 0.625rem var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; color: var(--muted); white-space: nowrap; translate: 0 -50%; }
  .at-label.is-active .at-label__name { color: var(--gold); }
  .at-label img { margin-left: 18px; width: 9rem; aspect-ratio: 4 / 5; object-fit: cover; border: 4px solid var(--ink); box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5); rotate: -3deg; opacity: 0; transform: translateY(10px) scale(0.9); transition: opacity 0.6s var(--ease), transform 0.8s var(--ease); }
  .at-label.is-active img { opacity: 1; transform: none; }
  @media (max-width: 767px) { .at-label img { width: 5.5rem; } }

  /* ---- header ---- */
  .at-header { position: fixed; inset: 0 0 auto; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 1.25rem var(--gutter); background: linear-gradient(rgba(6, 10, 18, 0.7), transparent); }
  .at-header__brand { font: 400 1.25rem var(--font-display); text-decoration: none; }
  .at-header__brand em { color: var(--gold); }
  .at-header__nav { display: flex; gap: clamp(1rem, 2.5vw, 2.25rem); font-size: 0.875rem; }
  .at-header__nav a { text-decoration: none; color: var(--muted); transition: color 0.3s; }
  .at-header__nav a:hover { color: var(--ink); }
  .at-header__pos { justify-self: end; color: var(--muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 767px) { .at-header { grid-template-columns: 1fr auto; } .at-header__nav { display: none; } .at-header__brand { white-space: nowrap; } }
  @media (max-width: 480px) { .at-header__pos { display: none; } }

  main { position: relative; z-index: 2; pointer-events: none; }
  main a, main button, .at-stop__card, .at-notebook, .at-footer { pointer-events: auto; }

  /* ---- hero ---- */
  .at-hero { min-height: 100svh; display: grid; align-items: center; padding: 7rem var(--gutter) 4rem; position: relative; }
  .at-hero__col { max-width: 40rem; }
  .at-hero__title { font: 300 clamp(3.75rem, 10vw, 9.5rem)/0.9 var(--font-display); letter-spacing: -0.035em; font-variation-settings: "SOFT" 50, "opsz" 144; }
  .at-hero__line { display: block; }
  .at-hero__line--it { font-size: 0.42em; letter-spacing: -0.01em; margin-top: 0.35em; color: var(--gold); line-height: 1.05; }
  .at-hero__intro { margin-top: 2rem; max-width: 30rem; color: var(--muted); font-size: 1.0625rem; }
  .at-hero__ctas { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2.25rem; }
  .at-btn { display: inline-flex; gap: 0.6rem; align-items: center; padding: 0.85rem 1.4rem; border: 1px solid var(--faint); border-radius: 999px; text-decoration: none; font-weight: 500; font-size: 0.9375rem; backdrop-filter: blur(6px); transition: background-color 0.3s, color 0.3s, border-color 0.3s; }
  .at-btn:hover { border-color: var(--gold); color: var(--gold); }
  .at-btn--solid { background: var(--gold); color: var(--night); border-color: var(--gold); }
  .at-btn--solid:hover { background: transparent; }
  .at-hero__hint { position: absolute; right: var(--gutter); bottom: 2rem; color: var(--muted); }
  @media (max-width: 767px) {
    .at-hero { align-items: end; padding-top: 55svh; }
    .at-hero__hint { display: none; }
  }
  html.js .at-hero [data-hero-in] { opacity: 0; transform: translateY(16px); }

  /* ---- journey ---- */
  .at-journey { position: relative; }
  .at-stop { min-height: 110svh; display: flex; align-items: center; padding: 6rem var(--gutter); }
  .at-stop__card {
    width: min(26rem, 100%); padding: clamp(1.5rem, 3vw, 2.25rem); border: 1px solid var(--faint); border-radius: 4px;
    background: color-mix(in srgb, var(--night-2) 72%, transparent); backdrop-filter: blur(14px);
  }
  .at-stop__name { font: 300 clamp(2.75rem, 5.5vw, 4.5rem)/0.95 var(--font-display); letter-spacing: -0.03em; }
  .at-stop__coord { margin-top: 0.75rem; color: var(--muted); }
  .at-stop__note { margin-top: 1.25rem; font: italic 400 1.25rem/1.4 var(--font-display); }
  .at-stop__career { margin-top: 1.25rem; padding-top: 1rem; border-top: 1px solid var(--faint); display: grid; gap: 0.35rem; font-size: 0.9375rem; }
  .at-stop__career .at-mono { color: var(--gold); margin-right: 0.5rem; }
  .at-stop__photo { display: none; margin-top: 1.25rem; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 2px; }
  /* no globe (reduced motion / no WebGL) → photos live in the cards instead of on the map */
  html.no-globe .at-stop__photo { display: block; }
  html.no-globe .at-stop { min-height: auto; padding-block: 2rem; }
  @media (max-width: 767px) {
    .at-stop { align-items: end; min-height: 120svh; padding-bottom: 12svh; }
    .at-stop__card { width: 100%; }
  }

  /* ---- notebook ---- */
  .at-notebook { position: relative; padding: clamp(6rem, 16vh, 10rem) var(--gutter); background: linear-gradient(transparent, var(--night) 12rem); }
  .at-notebook__title { font: 300 clamp(2.5rem, 6vw, 5.5rem)/1 var(--font-display); letter-spacing: -0.03em; max-width: 16ch; }
  .at-notebook__title em { color: var(--gold); }
  .at-notebook__grid { display: grid; grid-template-columns: repeat(12, 1fr); gap: 1rem; margin-top: clamp(3rem, 8vh, 5rem); }
  .at-panel { grid-column: span 4; padding: 1.75rem; border: 1px solid var(--faint); border-radius: 4px; background: rgba(11, 18, 32, 0.6); }
  .at-panel--career { grid-column: span 5; grid-row: span 2; }
  .at-panel--projects { grid-column: span 7; }
  .at-panel__title { display: flex; justify-content: space-between; align-items: baseline; font: 400 1.75rem var(--font-display); margin-bottom: 1.25rem; }
  .at-panel__title .at-mono { color: var(--muted); }
  @media (max-width: 1000px) { .at-panel, .at-panel--career, .at-panel--projects { grid-column: 1 / -1; grid-row: auto; } }

  .at-timeline { position: relative; display: grid; gap: 1.5rem; padding-left: 1.5rem; }
  .at-timeline::before { content: ""; position: absolute; left: 4px; top: 0.4rem; bottom: 0.4rem; width: 1px; background: linear-gradient(var(--gold), var(--faint)); }
  .at-timeline li { position: relative; display: grid; gap: 0.15rem; }
  .at-timeline li::before { content: ""; position: absolute; left: calc(-1.5rem + 1px); top: 0.3rem; width: 7px; height: 7px; border-radius: 50%; background: var(--night); border: 1px solid var(--gold); }
  .at-timeline li.is-work::before { background: var(--gold); }
  .at-timeline .at-mono { color: var(--gold); }
  .at-timeline strong { font: 400 1.35rem/1.2 var(--font-display); }
  .at-timeline span:last-child { color: var(--muted); font-size: 0.875rem; }

  .at-projects { display: grid; grid-template-columns: repeat(auto-fill, minmax(14rem, 1fr)); gap: 0.75rem; }
  .at-projects a { display: grid; gap: 0.35rem; align-content: start; height: 100%; padding: 1rem; border: 1px solid var(--faint); border-radius: 3px; text-decoration: none; transition: border-color 0.3s, background-color 0.3s, transform 0.5s var(--ease); }
  .at-projects a:hover { border-color: var(--gold); background: rgba(240, 194, 112, 0.06); transform: translateY(-3px); }
  .at-projects .at-mono { color: var(--gold); }
  .at-projects strong { font-weight: 600; }
  .at-projects span:last-child { color: var(--muted); font-size: 0.875rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }

  .at-bullets { display: grid; gap: 0.75rem; color: var(--muted); }
  .at-bullets li { padding-left: 1.1rem; position: relative; }
  .at-bullets li::before { content: "→"; position: absolute; left: 0; color: var(--gold); }
  .at-post { display: grid; gap: 0.25rem; text-decoration: none; }
  .at-post strong { font: 400 1.25rem/1.2 var(--font-display); transition: color 0.3s; }
  .at-post span { color: var(--muted); font-size: 0.875rem; }
  .at-post:hover strong { color: var(--gold); }
  .at-interests { display: grid; gap: 0.75rem; }
  .at-interests dt { font-weight: 600; }
  .at-interests dd { color: var(--muted); font-size: 0.875rem; }

  /* ---- footer ---- */
  .at-footer { position: relative; padding: clamp(6rem, 16vh, 10rem) var(--gutter) 2rem; background: var(--night); }
  .at-footer__cta { display: block; font: 300 clamp(4.5rem, 16vw, 17rem)/0.88 var(--font-display); letter-spacing: -0.045em; text-decoration: none; }
  .at-footer__cta em { color: var(--gold); }
  .at-footer__row { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 1.25rem; margin-top: clamp(3rem, 10vh, 6rem); padding-top: 1.25rem; border-top: 1px solid var(--faint); color: var(--muted); }
  .at-footer__row ul { display: flex; gap: 1.5rem; }
  .at-footer__row a { text-decoration: none; transition: color 0.3s; }
  .at-footer__row a:hover { color: var(--gold); }
</style>

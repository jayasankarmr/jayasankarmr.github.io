---
// Concept B — "Blueprint": engineering precision. The page is a drawing sheet.
import Base from "../../layouts/Base.astro";
import "../../styles/cursor.css";
import { site, socials } from "../../data/site";
import { career, skills } from "../../data/career";
import { getProjects } from "../../data/projects";

const projects = await getProjects();

// deterministic short "commit hash" per entry, so it never changes between builds
const hash = (s: string) => {
  let h = 2166136261;
  for (const c of s) h = Math.imul(h ^ c.charCodeAt(0), 16777619);
  return (h >>> 0).toString(16).padStart(8, "0").slice(0, 7);
};
const verb = { work: "feat", milestone: "ship", education: "learn" } as const;
const scope = { work: "work", milestone: "oss", education: "edu" } as const;
const fmt = (d?: string) => (d ? new Date(d + "-01").toLocaleDateString("en-GB", { month: "short", year: "numeric" }) : "present");
const commits = career.map((c, i) => ({
  ...c,
  hash: hash(c.title + c.org + c.start),
  lane: c.kind === "education" ? 1 : 0,
  head: i === 0,
  last: i === career.length - 1,
}));
const updated = (d?: string) => (d ? new Date(d).toLocaleDateString("en-GB", { day: "2-digit", month: "short", year: "numeric" }) : "—");
const pad = (n: number) => String(n).padStart(2, "0");
---
<Base
  title="Jayasankar M R — Blueprint (concept B)"
  fonts="family=Archivo:wdth,wght@62..125,100..900&family=JetBrains+Mono:wght@400;500"
  bodyClass="bp"
  noindex
>
  <div class="bp-loader" data-loader>
    <p>&gt; init portfolio --user jayasankarmr</p>
    <p>&gt; resolving career, projects, frames, places</p>
    <p>&gt; building sheet <span data-loader-count>000</span>%</p>
    <span class="bp-loader__bar" data-loader-bar></span>
  </div>

  <div class="bp-grid-bg" aria-hidden="true"></div>
  <div class="bp-cross" data-cross aria-hidden="true">
    <span class="bp-cross__h"></span><span class="bp-cross__v"></span>
    <span class="bp-cross__read" data-cross-read>X 0.000 · Y 0.000</span>
  </div>

  <header class="bp-header">
    <a class="bp-header__brand" href="#main">JMR<span>/{new Date().getFullYear()}</span></a>
    <nav class="bp-header__nav" aria-label="Primary">
      <a href="#log"><i>01</i>Career</a>
      <a href="#projects"><i>02</i>Code</a>
      <a href="/photography/"><i>03</i>Photography</a>
      <a href="#contact"><i>04</i>Contact</a>
    </nav>
    <p class="bp-header__clock">IST <time data-clock>--:--:--</time></p>
  </header>

  <main id="main">
    <!-- ============ HERO ============ -->
    <section class="bp-hero" data-hero aria-labelledby="bp-name">
      <canvas class="bp-hero__canvas" data-hero-canvas aria-hidden="true"></canvas>
      <h1 id="bp-name" class="bp-hero__name"><span>Jayasankar</span> <span>M R</span></h1>

      <p class="bp-tag bp-hero__sheet">Sheet 01 / 04 — Index</p>
      <p class="bp-tag bp-hero__rev">Rev. 2026.09 · Scale 1:1</p>

      <div class="bp-hero__dim" aria-hidden="true"><span>Jayasankar M R — 10 chars · 1 human</span></div>

      <div class="bp-hero__foot">
        <div class="bp-hero__card">
          <p class="bp-tag">Spec</p>
          <p class="bp-hero__role">{site.role}</p>
          <p class="bp-hero__intro">{site.intro}</p>
        </div>
        <dl class="bp-hero__facts">
          <div><dt>Based</dt><dd>{site.location}</dd></div>
          <div><dt>Coords</dt><dd>10.02°N 76.31°E</dd></div>
          <div><dt>Scroll</dt><dd><span data-scroll-pct>000.0</span>%</dd></div>
        </dl>
      </div>
    </section>

    <!-- ============ STATEMENT ============ -->
    <section class="bp-sec bp-about" aria-labelledby="bp-about-h">
      <p class="bp-tag bp-sec__label" data-reveal>02 / About</p>
      <h2 id="bp-about-h" class="bp-about__text" data-reveal="split">
        I design systems that behave the same way twice — and take photographs of moments that never will.
      </h2>
      <div class="bp-skills" data-reveal>
        {Object.entries(skills).map(([group, items]) => (
          <div>
            <p class="bp-tag">{group}</p>
            <ul role="list">{items.map((s) => <li>{s}</li>)}</ul>
          </div>
        ))}
      </div>
    </section>

    <!-- ============ GIT LOG ============ -->
    <section class="bp-sec bp-log" id="log" aria-labelledby="bp-log-h">
      <p class="bp-tag bp-sec__label">03 / Career</p>
      <h2 id="bp-log-h" class="bp-log__cmd"><span class="bp-log__prompt">$</span> <span data-type>git log --graph --career</span><span class="bp-caret" aria-hidden="true"></span></h2>

      <ol class="bp-commits" role="list">
        {commits.map((c) => (
          <li class="bp-commit" data-commit data-lane={c.lane}>
            <svg class="bp-commit__graph" viewBox="0 0 56 100" preserveAspectRatio="none" aria-hidden="true">
              <path class="bp-g-main" d={`M16 ${c.head ? 30 : 0} V ${c.last ? 30 : 100}`} />
              {c.lane === 1 && <path class="bp-g-branch" d={c.last ? "M16 0 C 16 18, 40 12, 40 30" : "M16 0 C 16 18, 40 12, 40 30 C 40 48, 16 42, 16 100"} />}
            </svg>
            <span class="bp-commit__node" aria-hidden="true"></span>
            <div class="bp-commit__meta">
              <span class="bp-commit__hash">{c.hash}</span>
              {c.head && <span class="bp-commit__ref">HEAD → main</span>}
              {c.lane === 1 && <span class="bp-commit__ref bp-commit__ref--edu">edu</span>}
            </div>
            <div class="bp-commit__body">
              <p class="bp-commit__msg" data-scramble>{verb[c.kind]}({scope[c.kind]}): {c.title} @ {c.org}</p>
              <p class="bp-commit__sum">{c.summary}</p>
              {c.tags && <p class="bp-commit__tags">{c.tags.map((t) => <span>#{t.toLowerCase()}</span>)}</p>}
            </div>
            <p class="bp-commit__date"><time>{fmt(c.start)}</time> — <time>{fmt(c.end)}</time>{c.place && <span>{c.place}</span>}</p>
          </li>
        ))}
      </ol>
    </section>

    <!-- ============ PROJECTS ============ -->
    <section class="bp-sec bp-projects" id="projects" aria-labelledby="bp-proj-h">
      <p class="bp-tag bp-sec__label">04 / Code</p>
      <h2 id="bp-proj-h" class="bp-log__cmd"><span class="bp-log__prompt">$</span> ls -la ~/projects <span class="bp-dim">— {projects.length} entries, live from GitHub</span></h2>
      <ul class="bp-table" role="list">
        {projects.map((p, i) => (
          <li data-reveal>
            <a href={p.url} target="_blank" rel="noopener" data-cursor="Open">
              <span class="bp-table__i">{pad(i + 1)}</span>
              <span class="bp-table__name">{p.name}</span>
              <span class="bp-table__desc">{p.description}</span>
              <span class="bp-table__lang">{p.language ?? p.tags[0]}</span>
              <span class="bp-table__date">{updated(p.updated)}</span>
              <span class="bp-table__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <!-- ============ FOOTER ============ -->
    <footer class="bp-footer" id="contact">
      <p class="bp-tag">05 / Contact</p>
      <a class="bp-footer__cta" href={`mailto:${site.email}`} data-cursor="Email" data-reveal="chars">Let’s build</a>
      <div class="bp-footer__row">
        <a href={`mailto:${site.email}`}>{site.email}</a>
        {socials.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label} ↗</a>)}
        <a href="/photography/">Photography →</a>
        <span>EOF · © 2026</span>
      </div>
    </footer>
  </main>
</Base>

<script>
  import "../../scripts/concepts/blueprint";
</script>

<style is:global>
  body.bp {
    --paper: #ecebe5;
    --paper-2: #e3e2db;
    --ink: #121212;
    --muted: rgba(18, 18, 18, 0.58);
    --rule: rgba(18, 18, 18, 0.14);
    --signal: #2b4dff;
    --font-display: "Archivo", system-ui, sans-serif;
    --font-mono: "JetBrains Mono", ui-monospace, monospace;
    --gutter: clamp(1rem, 3vw, 2.5rem);
    --ease: cubic-bezier(0.22, 1, 0.36, 1);
    --cursor-ink: var(--ink);
    --cursor-fill: var(--signal);
    --cursor-label: #fff;
    --focus: var(--signal);
    --skip-bg: var(--signal);
    background: var(--paper);
    color: var(--ink);
    font: 400 1rem/1.55 var(--font-display);
    font-stretch: 100%;
  }
  .bp ::selection { background: var(--signal); color: #fff; }
  .bp-tag { font: 500 0.6875rem/1.4 var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; color: var(--muted); }
  .bp-dim { color: var(--muted); font-size: 0.8125rem; }

  /* blueprint grid: minor every 1/24 of the width, major every 1/6 */
  .bp-grid-bg {
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background-image:
      linear-gradient(to right, var(--rule) 1px, transparent 1px),
      linear-gradient(to bottom, var(--rule) 1px, transparent 1px),
      linear-gradient(to right, rgba(18, 18, 18, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(18, 18, 18, 0.05) 1px, transparent 1px);
    background-size: calc(100% / 6) 100%, 100% calc(100vw / 6), calc(100% / 24) 100%, 100% calc(100vw / 24);
    mask-image: linear-gradient(transparent, #000 10%, #000 90%, transparent);
  }
  main, .bp-header { position: relative; z-index: 1; }

  .bp-cross { position: fixed; inset: 0; pointer-events: none; z-index: 2; opacity: 0; transition: opacity 0.3s; }
  .bp-cross.is-on { opacity: 1; }
  .bp-cross__h, .bp-cross__v { position: absolute; background: var(--signal); opacity: 0.5; }
  .bp-cross__h { left: 0; right: 0; height: 1px; top: 0; }
  .bp-cross__v { top: 0; bottom: 0; width: 1px; left: 0; }
  .bp-cross__read { position: absolute; top: 0; left: 0; padding: 0.2rem 0.4rem; font: 500 0.625rem var(--font-mono); background: var(--signal); color: #fff; white-space: nowrap; }

  /* ---- loader ---- */
  .bp-loader { position: fixed; inset: 0; z-index: 100; background: var(--ink); color: var(--paper); padding: var(--gutter); display: grid; align-content: end; gap: 0.35rem; font: 400 0.8125rem var(--font-mono); clip-path: inset(0); }
  html:not(.js) .bp-loader { display: none; }
  .bp-loader p:last-of-type { color: #8fa2ff; }
  .bp-loader__bar { position: absolute; left: 0; bottom: 0; height: 3px; width: 100%; background: var(--signal); transform: scaleX(0); transform-origin: left; }

  /* ---- header ---- */
  .bp-header { position: fixed; inset: 0 0 auto; z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 1rem var(--gutter); font: 500 0.75rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.06em; background: color-mix(in srgb, var(--paper) 82%, transparent); backdrop-filter: blur(8px); border-bottom: 1px solid var(--rule); }
  .bp-header__brand { text-decoration: none; font-weight: 500; }
  .bp-header__brand span { color: var(--signal); }
  .bp-header__nav { display: flex; gap: clamp(0.75rem, 2vw, 2rem); }
  .bp-header__nav a { text-decoration: none; display: inline-flex; gap: 0.4rem; }
  .bp-header__nav i { font-style: normal; color: var(--signal); }
  .bp-header__nav a:hover { color: var(--signal); }
  .bp-header__clock { justify-self: end; font-variant-numeric: tabular-nums; }
  @media (max-width: 767px) { .bp-header { grid-template-columns: 1fr auto; } .bp-header__nav { display: none; } }

  /* ---- hero ---- */
  .bp-hero { position: relative; height: 100svh; min-height: 36rem; overflow: clip; }
  .bp-hero__canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .bp-hero__name {
    position: absolute; inset: 0; display: grid; place-content: center; text-align: center; padding: 0 var(--gutter);
    font: 800 clamp(3rem, 12.5vw, 14rem)/0.85 var(--font-display); font-stretch: 125%; text-transform: uppercase; letter-spacing: -0.02em;
    transition: opacity 0.6s;
  }
  .bp-hero__name span:last-child { display: none; }
  /* once the particle name is live, the DOM heading stays for screen readers only */
  .bp-hero:has(.bp-hero__canvas.is-live) .bp-hero__name { opacity: 0; }
  .bp-hero__sheet { position: absolute; top: 5rem; left: var(--gutter); }
  .bp-hero__rev { position: absolute; top: 5rem; right: var(--gutter); }
  .bp-hero__dim {
    position: absolute; left: 7%; right: 7%; top: 30%; height: 1px; background: var(--ink); opacity: 0.5;
  }
  .bp-hero__dim::before, .bp-hero__dim::after { content: ""; position: absolute; top: -6px; width: 1px; height: 13px; background: var(--ink); }
  .bp-hero__dim::before { left: 0; } .bp-hero__dim::after { right: 0; }
  .bp-hero__dim span { position: absolute; left: 50%; top: -0.6rem; translate: -50% 0; padding: 0 0.6rem; background: var(--paper); font: 500 0.625rem var(--font-mono); letter-spacing: 0.08em; text-transform: uppercase; white-space: nowrap; }
  .bp-hero__foot { position: absolute; left: var(--gutter); right: var(--gutter); bottom: var(--gutter); display: flex; justify-content: space-between; align-items: end; gap: 2rem; }
  .bp-hero__card { max-width: 26rem; padding: 1.25rem; border: 1px solid var(--ink); background: var(--paper); display: grid; gap: 0.5rem; }
  .bp-hero__role { font-size: 1.375rem; font-weight: 600; font-stretch: 112%; line-height: 1.1; }
  .bp-hero__intro { color: var(--muted); font-size: 0.9375rem; }
  .bp-hero__facts { display: grid; gap: 0; font: 500 0.75rem var(--font-mono); text-transform: uppercase; min-width: 15rem; border: 1px solid var(--ink); background: var(--paper); }
  .bp-hero__facts div { display: flex; justify-content: space-between; gap: 1.5rem; padding: 0.5rem 0.75rem; }
  .bp-hero__facts div + div { border-top: 1px solid var(--rule); }
  .bp-hero__facts dt { color: var(--muted); }
  .bp-hero__facts dd { font-variant-numeric: tabular-nums; }
  @media (max-width: 767px) {
    .bp-hero__name span:last-child { display: inline; }
    .bp-hero__facts, .bp-hero__dim, .bp-hero__rev { display: none; }
  }
  html.js .bp-hero__foot > *, html.js .bp-hero__dim, html.js .bp-hero__sheet, html.js .bp-hero__rev { opacity: 0; transform: translateY(12px); transition: opacity 0.9s var(--ease), transform 1s var(--ease); }
  html.js.is-loaded .bp-hero__foot > *, html.js.is-loaded .bp-hero__dim, html.js.is-loaded .bp-hero__sheet, html.js.is-loaded .bp-hero__rev { opacity: 1; transform: none; transition-delay: 0.9s; }
  html.js.is-loaded .bp-hero__dim { opacity: 0.5; }

  /* ---- sections ---- */
  .bp-sec { padding: clamp(5rem, 14vh, 9rem) var(--gutter); border-top: 1px solid var(--ink); background: color-mix(in srgb, var(--paper) 88%, transparent); }
  .bp-sec__label { margin-bottom: 2.5rem; color: var(--signal); }
  .bp-about__text { font: 500 clamp(2rem, 4.6vw, 4.5rem)/1.02 var(--font-display); font-stretch: 88%; letter-spacing: -0.025em; max-width: 22ch; }
  .bp-skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr)); margin-top: clamp(3rem, 8vh, 6rem); border-top: 1px solid var(--ink); }
  .bp-skills > div { padding: 1rem 1rem 1rem 0; }
  .bp-skills > div + div { padding-left: 1rem; border-left: 1px solid var(--rule); }
  .bp-skills ul { margin-top: 0.75rem; display: grid; gap: 0.25rem; font-size: 1.0625rem; font-weight: 500; }

  .bp-log__cmd { font: 500 clamp(1.1rem, 2.2vw, 1.6rem) var(--font-mono); letter-spacing: -0.01em; margin-bottom: 2.5rem; }
  .bp-log__prompt { color: var(--signal); }
  .bp-caret { display: inline-block; width: 0.6em; height: 1.1em; margin-left: 0.2em; vertical-align: -0.2em; background: var(--signal); animation: bp-blink 1s steps(2) infinite; }
  @keyframes bp-blink { 50% { opacity: 0; } }

  .bp-commits { border-top: 1px solid var(--ink); }
  .bp-commit {
    position: relative; display: grid; grid-template-columns: 56px 9rem 1fr 13rem; gap: 0 1.5rem; align-items: start;
    padding: 1.75rem 0; border-bottom: 1px solid var(--rule);
  }
  .bp-commit__graph { position: absolute; left: 0; top: 0; width: 56px; height: 100%; overflow: visible; }
  .bp-commit__graph path { fill: none; stroke: var(--ink); stroke-width: 1.5; vector-effect: non-scaling-stroke; }
  .bp-commit__graph .bp-g-branch { stroke: var(--signal); }
  .bp-commit__node { position: absolute; left: 10px; top: calc(30% - 6px); width: 13px; height: 13px; border-radius: 50%; background: var(--paper); border: 2px solid var(--ink); }
  .bp-commit[data-lane="1"] .bp-commit__node { left: 34px; border-color: var(--signal); }
  .bp-commit:first-child .bp-commit__node { background: var(--signal); border-color: var(--signal); box-shadow: 0 0 0 5px color-mix(in srgb, var(--signal) 20%, transparent); }
  .bp-commit__meta { grid-column: 2; display: grid; gap: 0.4rem; justify-items: start; font: 500 0.8125rem var(--font-mono); }
  .bp-commit__hash { color: var(--signal); }
  .bp-commit__ref { padding: 0.1rem 0.45rem; border: 1px solid var(--signal); color: var(--signal); font-size: 0.6875rem; text-transform: uppercase; }
  .bp-commit__ref--edu { border-style: dashed; }
  .bp-commit__msg { font: 500 clamp(1.05rem, 1.7vw, 1.4rem)/1.3 var(--font-mono); letter-spacing: -0.02em; }
  .bp-commit__sum { margin-top: 0.5rem; color: var(--muted); max-width: 52ch; }
  .bp-commit__tags { margin-top: 0.75rem; display: flex; flex-wrap: wrap; gap: 0.75rem; font: 500 0.75rem var(--font-mono); color: var(--signal); }
  .bp-commit__date { font: 500 0.75rem/1.6 var(--font-mono); text-transform: uppercase; text-align: right; }
  .bp-commit__date span { display: block; color: var(--muted); }
  @media (max-width: 900px) {
    .bp-commit { grid-template-columns: 56px 1fr; row-gap: 0.75rem; }
    .bp-commit__meta { grid-template-columns: auto auto; }
    .bp-commit__body, .bp-commit__date { grid-column: 2; text-align: left; }
  }

  .bp-table { border-top: 1px solid var(--ink); }
  .bp-table a {
    display: grid; grid-template-columns: 3rem minmax(12rem, 1.1fr) 2fr 9rem 8rem 1.5rem; gap: 1.5rem; align-items: baseline;
    padding: 1.1rem 0.75rem; border-bottom: 1px solid var(--rule); text-decoration: none; position: relative; isolation: isolate;
    transition: color 0.35s var(--ease);
  }
  .bp-table a::before { content: ""; position: absolute; inset: 0; z-index: -1; background: var(--signal); transform: scaleY(0); transform-origin: bottom; transition: transform 0.45s var(--ease); }
  .bp-table a:hover, .bp-table a:focus-visible { color: #fff; }
  .bp-table a:hover::before, .bp-table a:focus-visible::before { transform: scaleY(1); }
  .bp-table__i, .bp-table__lang, .bp-table__date { font: 500 0.75rem var(--font-mono); text-transform: uppercase; }
  .bp-table__name { font-size: 1.35rem; font-weight: 700; font-stretch: 110%; letter-spacing: -0.01em; }
  .bp-table__desc { color: inherit; opacity: 0.7; font-size: 0.9375rem; }
  .bp-table__arrow { justify-self: end; transition: transform 0.4s var(--ease); }
  .bp-table a:hover .bp-table__arrow { transform: translate(3px, -3px); }
  @media (max-width: 900px) {
    .bp-table a { grid-template-columns: 2.5rem 1fr auto; gap: 0.35rem 1rem; }
    .bp-table__desc { grid-column: 2 / -1; }
    .bp-table__date, .bp-table__arrow { display: none; }
    .bp-table__lang { grid-row: 1; grid-column: 3; }
  }

  /* ---- footer ---- */
  .bp-footer { position: relative; z-index: 1; padding: clamp(5rem, 14vh, 9rem) var(--gutter) var(--gutter); background: var(--ink); color: var(--paper); }
  .bp-footer .bp-tag { color: #8fa2ff; }
  .bp-footer__cta { display: block; margin-top: 1.5rem; font: 800 clamp(3.5rem, 13vw, 15rem)/0.85 var(--font-display); font-stretch: 125%; text-transform: uppercase; letter-spacing: -0.03em; text-decoration: none; transition: color 0.4s; }
  .bp-footer__cta:hover { color: #8fa2ff; }
  .bp-footer__row { display: flex; flex-wrap: wrap; gap: 1rem 2rem; margin-top: clamp(3rem, 10vh, 6rem); padding-top: 1.25rem; border-top: 1px solid rgba(236, 235, 229, 0.2); font: 500 0.75rem var(--font-mono); text-transform: uppercase; }
  .bp-footer__row a { text-decoration: none; }
  .bp-footer__row a:hover { color: #8fa2ff; }
  .bp-footer__row span { margin-left: auto; opacity: 0.5; }
</style>
